# Public frontend configuration only. Copy to .env.hosting.local.
# No credentials, tokens, ERP/provider keys, service-account files or Firebase Auth.
VITE_API_BASE_URL=https://your-approved-backend.example/api
VITE_WS_BASE_URL=wss://your-approved-backend.example/ws
# A real project identifier is required for a deployable build, not for emulator tests.
LCWE_FIREBASE_PROJECT_ID=your-approved-firebase-project
