{
  "hosting": {
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map", "**/*.pem", "**/*.key"],
    "predeploy": ["node frontend/scripts/verify-hosting-artifact.mjs --base-template"],
    "rewrites": [{ "regex": "^[/\\\\]($|(?:chat|activity|company|workflows|builder|executions|analytics|users|roles|audit|settings|registry|mcp-bridge|datafeed|registry-search|profile|login|register|forgot-password|unauthorized)(?:[/\\\\].*)?$)", "destination": "/index.html" }],
    "headers": [
      { "regex": ".*", "headers": [
        { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.iconify.design https://api.simplesvg.com https://api.unisvg.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" }
      ] },
      { "regex": "^[/\\\\]assets[/\\\\][^/\\\\]+-[A-Za-z0-9_-]{8,}\\.(js|css|woff2?|png|jpg|jpeg|svg|webp)$", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  },
  "emulators": {
    "hosting": { "host": "127.0.0.1", "port": 23571 },
    "hub": { "host": "127.0.0.1", "port": 23572 },
    "logging": { "host": "127.0.0.1", "port": 23573 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
