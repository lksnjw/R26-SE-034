{
  "openapi": "3.1.0",
  "info": {
    "title": "Sri Lanka Employee Registration Policy Gate",
    "description": "Validate employee form data against EMP-REG-001 through EMP-REG-011. Returns ALLOW, BLOCK or ESCALATE. Only the authenticated ERP backend may call this API; it must enforce ALLOW before creating an account.",
    "version": "3.0.0"
  },
  "paths": {
    "/api/policy/employee-registration/validate": {
      "post": {
        "tags": [
          "Employee registration"
        ],
        "summary": "Validate Registration",
        "description": "Trusted ERP backend only. Call before create-user; proceed only on ALLOW.",
        "operationId": "validate_registration_api_policy_employee_registration_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BackendApiKey": []
          }
        ]
      }
    },
    "/api/policy/evaluate": {
      "post": {
        "tags": [
          "Employee registration"
        ],
        "summary": "Validate Registration",
        "description": "Trusted ERP backend only. Call before create-user; proceed only on ALLOW.",
        "operationId": "validate_registration_api_policy_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BackendApiKey": []
          }
        ]
      }
    },
    "/api/policy/actions": {
      "get": {
        "tags": [
          "Employee registration"
        ],
        "summary": "Actions",
        "operationId": "actions_api_policy_actions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "BackendApiKey": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
