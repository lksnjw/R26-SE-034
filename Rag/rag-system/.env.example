# NO TRAILING COMMENTS ON ASSIGNMENTS. python-dotenv strips them; Docker's
# --env-file does not, so `QDRANT_TIMEOUT=60  # seconds` reaches the container as
# the literal string "60  # seconds" and the app dies on startup validation.
# Keep comments on their own lines.
#
# ─────────────────────────────────────────────────
#  MODEL BACKEND
#  ollama = local, no key, runnable offline
#  api    = any OpenAI-compatible endpoint (Gemini, Groq, OpenRouter, vLLM)
# ─────────────────────────────────────────────────
MODEL_PROVIDER=api

# --- MODEL_PROVIDER=api : Google Gemini (current) ---
# Key from aistudio.google.com. Free tier: 15 req/min, 1000 req/day.
API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite
API_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSION=3072

# Reasoning models spend tokens before emitting JSON; a reply truncated
# mid-object raises LengthFinishReasonError, which the gate reports as "judge
# unavailable" and denies a permitted request.
API_TOKEN_FACTOR=8
# Free-tier limits are per-MINUTE, so the backoff must outlast a whole window.
# A 429 reaches the gate as a denial — a failure that reads as strict policy.
API_MAX_RETRIES=8

# --- MODEL_PROVIDER=ollama (local; Ollama must be running) ---
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2:3b
# EMBED_MODEL=nomic-embed-text
# EMBED_DIMENSION=768
#
# Every provider serves a different embedding model at a different width —
# nomic 768, gemini-embedding-001 3072, nemotron-3-embed-1b 2048 — and a Qdrant
# collection is fixed at the width it was created with. Switching provider is
# therefore always a rebuild, never an upsert:
#   python -m scripts.seed_qdrant_policies --recreate

# ─────────────────────────────────────────────────
#  QDRANT  (must be reachable — there is no offline mode)
#  Local:  docker compose -f docker/docker-compose.yml up -d
# ─────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_docs
QDRANT_API_KEY=
QDRANT_TIMEOUT=60

# ─────────────────────────────────────────────────
#  POLICY GATE
# ─────────────────────────────────────────────────
POLICY_COLLECTION=policy_docs
POLICY_TOP_K=20
POLICY_FAIL_CLOSED=True

# ─────────────────────────────────────────────────
#  SERVING / ACCESS CONTROL
# ─────────────────────────────────────────────────
# Injected by Azure Container Apps, Cloud Run, Railway. 8000 locally.
PORT=8000

# Comma-separated. EMPTY MEANS NO AUTHENTICATION.
#
# `actor.role` is trusted completely — it is supposed to come from the caller's
# authenticated session, and this service cannot verify that. Left empty on a
# public address, anyone can post role=finance_manager and be told the payment
# is permitted, so every threshold, role and segregation rule is decided on a
# string the sender chose. Set this before exposing the service.
API_KEYS=

# Narrow to the calling application's origin once deployed.
CORS_ORIGINS=*

# The demo page is served with an API key embedded so the browser can call the
# API — which hands that key to anyone who loads the page. Set False in any
# deployment where that matters.
ENABLE_DEMO=True

# ─────────────────────────────────────────────────
#  BASELINE SPLITTER
#  Used only by scripts.verify_policy_chunking, to reproduce what a general
#  character-window splitter does to a policy clause. Not used by the gate.
# ─────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
